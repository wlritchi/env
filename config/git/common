[user]
	name = Luc Ritchie
	email = luc.ritchie@gmail.com

[alias]
	rgrep = !git grep

[core]
	pager = delta
	attributesfile = ~/.gitattributes
	untrackedcache = true
	fsmonitor = true

[core "whitespace"]
	tab-in-indent = true
	tabwidth = 2

[color]
	ui = auto

[color "grep"]
	context = normal
	filename = green
	linenumber = red
	match = yellow bold
	selected = normal
	separator = cyan

[interactive]
	diffFilter = delta --color-only

[push]
	default = current

[gitreview]
	username = wlritchi

[diff]
	compactionHeuristic = true
	algorithm = histogram

[merge]
	renamelimit = 5000

[difftool]
	prompt = false

[mergetool]
	prompt = false

[init]
	defaultBranch = main

[feature]
	manyFiles = true

[commit]
	gpgsign = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[lfs]
	forceprogress = true

[credential "https://github.com"]
	helper =
	helper = !~/.nix-profile/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !~/.nix-profile/bin/gh auth git-credential

[gpg]
	format = ssh
	; The Nix profile provides wlr-git-gpg-verify (rust-utils/git-verify-cache).
	; It caches verification results for %G? in git log. Without the profile,
	; the bin/git/ fallback with the same name runs gpg directly.
	program = wlr-git-gpg-verify

[gpg "ssh"]
	allowedSignersFile = ~/.wlrenv/.allowed_signers
	; Verification calls go to git-verify-cache, which caches the results.
	; Signing calls go to wlr-git-ssh-sign (bin/git/). It asks for confirmation
	; and loads the key into ssh-agent, so passphrase retries work. If the Nix
	; profile has no git-verify-cache, the bin/git/ fallback with the same name
	; runs the bash dispatcher.
	; Git finds these programs through PATH. A GUI git client without the
	; wlrenv PATH cannot sign or verify with this setting.
	program = wlr-git-ssh-verify

[credential "https://git.wlritchi.com"]
	helper = store

[fetch]
	writeCommitGraph = true

[include]
	path = ~/.wlrenv/vendor/catppuccin-delta/catppuccin.gitconfig

[delta]
	navigate = true
	dark = true
	features = catppuccin-macchiato

[merge]
	conflictStyle = zdiff3
