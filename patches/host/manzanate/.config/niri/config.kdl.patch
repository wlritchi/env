     Alt+Shift+Ctrl+S { spawn "sshen-prompt"; }
-    Alt+Shift+M { spawn "alacritty" "-e" "minicom"; }
+    Alt+Shift+M { spawn "foot" "-e" "minicom"; }
     Alt+Shift+Ctrl+M { spawn "ssh-minicom-prompt"; }
 
-    Alt+Dollar { spawn "alacritty" "-e" "k9s"; }
-    Alt+Grave { spawn "alacritty" "-e" "k9s"; }
+    Alt+Dollar { spawn "foot" "-e" "k9s"; }
