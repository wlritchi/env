diff --git a/dotfiles/.config/niri/config.kdl b/dotfiles/.config/niri/config.kdl
--- a/dotfiles/.config/niri/config.kdl
+++ b/dotfiles/.config/niri/config.kdl
@@ -98,6 +98,28 @@
     background-color "#181926"  // crust
 }
 
+// manzanate (M3 Max, Asahi): the panel gives no EDID, so match the output
+// by connector. With the display driver (apple-drm), the connector is
+// eDP-1. With appledrm.show_notch=1, its mode includes the notch strip
+// (3456x2234). On the boot framebuffer (simpledrm), which an older m1n1 or
+// kernel gives, the connector is Unknown-1.
+// The panel is about 254 ppi. Scale 1.125 gives the same physical sizes as
+// amygdalin at scale 1.
+output "eDP-1" {
+    // 60 Hz while niri renders on the CPU (llvmpipe): 120 Hz doubles its
+    // cost during animation.
+    mode "3456x2234@60.000"
+    scale 1.125
+    position x=0 y=0
+    background-color "#181926"  // crust
+}
+
+output "Unknown-1" {
+    scale 1.125
+    position x=0 y=0
+    background-color "#181926"  // crust
+}
+
 output "Acer Technologies XZ242Q Unknown" {
     off
     mode "1920x1080"
@@ -329,17 +351,17 @@
