#!/bin/bash
set -euo pipefail

exec &> >(tee -a /tmp/manzanate-autorun.log)
echo "=== $(date) ==="

# There is no GPU driver for the M3 yet, so niri renders with llvmpipe.
# With m1n1 from 2026-11 and a 7.3.4-2 kernel, the display driver
# (apple-drm) replaces the boot framebuffer (simpledrm) about 8 s after
# boot. If niri starts on simpledrm before that, it loses its output. Wait
# up to 20 s for the display driver. With an older m1n1 or kernel, the wait
# times out and niri starts on simpledrm.
display_driver() {
    local c
    for c in /sys/class/drm/card[0-9]*; do
        [ -e "$c/device/driver" ] || continue
        case "$(basename "$(readlink -f "$c/device/driver")")" in
            simple-framebuffer) ;;
            *) echo "$c"; return 0 ;;
        esac
    done
    return 1
}
for _ in $(seq 20); do
    display_driver >/dev/null && break
    echo "Waiting for the display driver..."
    sleep 1
done
while ! compgen -G '/dev/dri/card*' >/dev/null; do
    echo "Waiting for a DRM device..."
    sleep 1
done
echo "DRM devices ready: $(ls /dev/dri/card* 2>/dev/null) (display driver: $(display_driver || echo none))"

echo "starting niri-session"
niri-session
echo "niri-session exited with code $?"
