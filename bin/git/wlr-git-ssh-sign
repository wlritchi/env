#!/usr/bin/env bash
set -euo pipefail

# Dependencies: ssh-keygen; uv for lib/git-ssh-sign.py, which does the signing.

# Git runs this program two times for each signed commit that it shows with
# %G? (for example in glog), so each call must start quickly. Send the
# verification operations that git uses directly to ssh-keygen. Send all
# other calls to the Python signer, which asks for confirmation before it
# signs. If a later argument could be another -Y option, use the signer.
if [[ $# -ge 2 && $1 == -Y ]]; then
    case $2 in
        verify | find-principals | check-novalidate)
            verify_only=true
            for arg in "${@:3}"; do
                if [[ $arg == -*Y* ]]; then
                    verify_only=false
                fi
            done
            if [[ $verify_only == true ]]; then
                exec ssh-keygen "$@"
            fi
            ;;
    esac
fi

exec "${BASH_SOURCE[0]%/*}/../../lib/git-ssh-sign.py" "$@"
