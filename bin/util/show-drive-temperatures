#!/bin/bash
set -euo pipefail

# Dependencies: smartctl, lsblk, rg, sudo

# Print the mount points and Ceph OSDs on a drive, or on block devices stacked on it (partitions,
# LVM, dm-crypt), as a comma-separated list.
describe_usage() {
    local drive="$1"
    local usages=()
    local mountpoint
    local device
    local osd_id
    local label_match
    local id_length

    while IFS= read -r mountpoint; do
        if [ -n "$mountpoint" ]; then
            usages+=("$mountpoint")
        fi
    done < <(lsblk -nlo MOUNTPOINTS "$drive" | sort -u)

    while IFS= read -r device; do
        # The bluestore label at the start of the device holds the OSD id in its "whoami" key, as
        # a string with a 32-bit little-endian length prefix. The bytes after the string can be
        # digits, so the length is necessary to find the end of the id.
        label_match="$(sudo head -c 4096 "$device" | rg -ao --replace '$1$2' '(?-u)whoami([\x01-\x09])\x00{3}([0-9]+)' | head -n1 || true)"
        osd_id=''
        if [ -n "$label_match" ]; then
            id_length="$(printf '%d' "'${label_match:0:1}")"
            osd_id="${label_match:1:id_length}"
        fi
        usages+=("osd.${osd_id:-?}")
    done < <(lsblk -nlpo NAME,FSTYPE "$drive" | awk '$2 == "ceph_bluestore" { print $1 }' | sort -u)

    local joined
    joined="$(printf '%s, ' "${usages[@]}")"
    printf '%s' "${joined%, }"
}

# Print the size of a drive in decimal terabytes, at most two decimal places.
describe_size() {
    lsblk -bdno SIZE "$1" | awk '{ size = sprintf("%.2f", $1 / 1e12); sub(/\.?0+$/, "", size); print size "TB" }'
}

for drive in /dev/sd*; do
    if echo "$drive" | rg -q '[0-9]$'; then
        continue
    fi
    if ! temp="$( ( sudo smartctl -a "$drive" || true) | rg ' Temperature' | head -n1 | sed -re 's/ \(.*//;s/.* //')"; then
        printf '%s: unable to read temperature (maybe not SMART-capable?)\n' "$drive"
    else
        serial_no="$( ( sudo smartctl -i "$drive" || true) | rg Serial | sed -re 's/.* //')"
        usage="$(describe_usage "$drive")"
        printf '%s (%s, %s): %s%s\n' "$drive" "$serial_no" "$(describe_size "$drive")" "$temp" "${usage:+ [$usage]}"
    fi
done
