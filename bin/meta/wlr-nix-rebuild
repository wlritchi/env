#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../../lib/nix-flake.bash
source "${BASH_SOURCE[0]%/*}/../../lib/nix-flake.bash"

usage() {
    cat <<'USAGE'
usage: wlr-nix-rebuild [--override-input INPUT FLAKEREF]...

Rebuild the home-manager (and on macOS, nix-darwin) environment. Use
wlr-nix-hm to run other home-manager subcommands with the same setup.

USAGE
    wlr_nix_flake_usage_overrides
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

wlr_nix_flake_setup "$@"
if [[ ${#wlr_nix_flake_args[@]} -gt 0 ]]; then
    usage >&2
    exit 1
fi

wlr_nix_flake_run home-manager switch

# On macOS, also run darwin-rebuild for system-level config (Homebrew casks, etc.)
if [ "$(uname -s)" = "Darwin" ]; then
    # Build first (no sudo needed) to check if anything changed
    wlr_nix_flake_run darwin-rebuild build

    # Compare new build to current system - only activate if different
    NEW_SYSTEM="$(readlink ./result)"
    CURRENT_SYSTEM="$(readlink /run/current-system 2>/dev/null || echo "")"

    if [ "${NEW_SYSTEM}" != "${CURRENT_SYSTEM}" ]; then
        # sudo's env_reset strips NIX_HOSTNAME/NIX_SYSTEM/NIX_CONFIG/HOME by
        # default; preserve them so the impure flake sees the same environment
        # as the unprivileged build above.
        sudo --preserve-env=NIX_HOSTNAME,NIX_SYSTEM,NIX_CONFIG,HOME \
            nix run --impure "$wlr_nix_flake_public_ref#darwin-rebuild" -- \
            switch --impure --flake "$wlr_nix_flake_ref#default" \
            ${wlr_nix_flake_overrides[@]+"${wlr_nix_flake_overrides[@]}"}
    else
        echo "nix-darwin: no changes to activate"
    fi

    # Clean up result symlink
    rm -f ./result
fi
