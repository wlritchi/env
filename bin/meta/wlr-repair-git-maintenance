#!/usr/bin/env bash
set -euo pipefail

# Write the `git maintenance` schedule again if the git binary that it runs
# no longer exists.
#
# `git maintenance start` puts the absolute path of the running git into the
# scheduler entry. When git comes from Nix, that path is a store path, and it
# is gone after the garbage collector removes the old generation. Then each
# scheduled run fails at exec, and nothing tells the user.
#
# Dependencies: git, sed; systemd, launchd, or cron (whichever holds the
# schedule)

# Print the git path of each scheduler entry, one per line.
scheduled_git_paths() {
    local unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/git-maintenance@.service"
    if [ -f "$unit" ]; then
        sed -n 's/^ExecStart="\([^"]*\)".*/\1/p' "$unit"
    fi

    local plist
    for plist in "$HOME"/Library/LaunchAgents/org.git-scm.git.*.plist; do
        [ -f "$plist" ] || continue
        sed -n 's|^<string>\(/.*/git\)</string>$|\1|p' "$plist"
    done

    if command -v crontab >/dev/null 2>&1; then
        crontab -l 2>/dev/null | sed -n \
            '/^# BEGIN GIT MAINTENANCE SCHEDULE$/,/^# END GIT MAINTENANCE SCHEDULE$/s/^[^"]*"\([^"]*\)".*/\1/p'
    fi
}

stale_path=
while IFS= read -r git_path; do
    if [ -n "$git_path" ] && [ ! -x "$git_path" ]; then
        stale_path="$git_path"
        break
    fi
done < <(scheduled_git_paths)

if [ -z "$stale_path" ]; then
    exit 0
fi

# `git maintenance start` also registers the current repository, so run it
# in a repository that is already registered.
repo=
while IFS= read -r candidate; do
    if git -C "$candidate" rev-parse --git-dir >/dev/null 2>&1; then
        repo="$candidate"
        break
    fi
done < <(git config --global --get-all maintenance.repo || true)

if [ -z "$repo" ]; then
    wlr-warn "git maintenance schedule runs missing $stale_path, but no registered repository exists; run 'git maintenance start' in a repository"
    exit 0
fi

wlr-warn "git maintenance schedule runs missing $stale_path; writing it again"
if ! git -C "$repo" maintenance start; then
    wlr-warn "git maintenance start failed; run it by hand in $repo"
fi
