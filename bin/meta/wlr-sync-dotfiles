#!/usr/bin/env bash
set -euo pipefail

# Usage: wlr-sync-dotfiles
#        wlr-sync-dotfiles --resolve [--hostname NAME] [--uname NAME] [PATH...]
#
# Without arguments, render every dotfile and link it into $HOME.
# With --resolve, print how each dotfile (or each given PATH) resolves,
# without rendering or linking. --hostname and --uname resolve as if run on
# that machine; wlr-verify-patches uses this to check every combination.
# Records are tab-separated, one per line:
#   env       HOSTNAME  UNAME
#   file      PATH
#   base      REPO      FILE
#   layer     REPO      DIM       VALUE     PATCH_FILE   (DIM is global, uname, or host)
#   rendered  FILE                                       (empty when there are no layers)
# wlr-reconcile-dotfiles consumes this so the layering logic lives here only.

UNAME_VAL="$(uname)"
RESOLVE_ONLY=
if [ "${1:-}" = '--resolve' ]; then
    RESOLVE_ONLY=y
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --hostname|--uname)
                if [ $# -lt 2 ]; then
                    wlr-err "$1 requires a value"
                    exit 2
                fi
                if [ "$1" = --hostname ]; then
                    HOSTNAME="$2"
                else
                    UNAME_VAL="$2"
                fi
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                wlr-err "unexpected option: $1"
                exit 2
                ;;
            *) break ;;
        esac
    done
elif [ $# -gt 0 ]; then
    wlr-err "unexpected argument: $1"
    exit 2
fi

# Private repo detection
PRIVATE_ENV_PATH="$HOME/.wlrenv-private"
HAS_PRIVATE=false
[[ -d "$PRIVATE_ENV_PATH" ]] && HAS_PRIVATE=true

print_diff() {
    if command -v delta >/dev/null 2>&1; then
        delta "$@" || true
    else
        diff "$@" || true
    fi
}

get_permissions() {
    if stat --version 2>/dev/null | grep -q GNU; then
        stat -c '%a' "$1" # GNU coreutils
    else
        stat -f '%A' "$1" # macOS, BSD
    fi
}

is_newer() {
    if stat --version 2>/dev/null | grep -q GNU; then
        # GNU coreutils
        mtime1="$(stat -c '%Y' "$1")"
        mtime2="$(stat -c '%Y' "$2")"
    else
        # macOS, BSD
        mtime1="$(stat -f '%m' "$1")"
        mtime2="$(stat -f '%m' "$2")"
    fi
    [ "$mtime1" -gt "$mtime2" ]
}

sync_dir() {
    local parent="${1%/*}"
    if [ "$parent" != "$1" ]; then
        sync_dir "$parent" || return 1
    fi
    if [ -d "$HOME/$1" ]; then
        if [ -L "$HOME/$1" ]; then
            target="$(realpath "$HOME/$1")"
            wlr-warn "update: $HOME/$1 is a directory symlink to $target"
            if wlr-ask "Replace with directory and copy contents of original target?"; then
                rm "$HOME/$1"
                cp -rp "$target" "$HOME/$1"
                return
            fi
            return 1
        fi
    elif [ -e "$HOME/$1" ]; then
        wlr-warn "update: $HOME/$1 exists, but is not a directory"
        return 1
    else
        mkdir -p "$HOME/$1"
    fi
}

# Append one repo's patch for one scope to the caller's patches array, if
# that patch exists. Reads $path and updates $patches, $layer_records, and
# $uses_private in the caller's scope.
# Args: <public|private> <global|uname|host> <scope value, empty for global>
add_patch() {
    local repo="$1"
    local dim="$2"
    local value="$3"
    local root
    case "$repo" in
        public) root="$WLR_ENV_PATH" ;;
        private)
            $HAS_PRIVATE || return 0
            root="$PRIVATE_ENV_PATH"
            ;;
    esac
    local file
    if [ "$dim" = global ]; then
        file="$root/patches/global/$path.patch"
    else
        [ -n "$value" ] || return 0
        file="$root/patches/$dim/$value/$path.patch"
    fi
    [ -f "$file" ] || return 0
    patches+=("$file")
    layer_records+=("$(printf 'layer\t%s\t%s\t%s\t%s' "$repo" "$dim" "$value" "$file")")
    if [ "$repo" = private ]; then
        uses_private=true
    fi
}

render_file() {
    local path="$1"
    local base_file=""
    local source=""
    local uses_private=false
    local uname_val="$UNAME_VAL"

    # Step 1: Determine base file
    # Scope priority: host > uname > global; private shadows public within each scope.
    # Patches in patches/ still apply on top regardless of which scope the base came from.
    local scopes=()
    if [ -n "$HOSTNAME" ]; then
        scopes+=("host/$HOSTNAME/$path")
    fi
    if [ -n "$uname_val" ]; then
        scopes+=("uname/$uname_val/$path")
    fi
    scopes+=("$path")

    for rel in "${scopes[@]}"; do
        if $HAS_PRIVATE && [ -f "$PRIVATE_ENV_PATH/dotfiles/$rel" ]; then
            base_file="$PRIVATE_ENV_PATH/dotfiles/$rel"
            source="private"
            uses_private=true
            break
        elif [ -f "$WLR_ENV_PATH/dotfiles/$rel" ]; then
            base_file="$WLR_ENV_PATH/dotfiles/$rel"
            source="public"
            break
        fi
    done

    if [ -z "$base_file" ]; then
        return 1
    fi

    # Step 2: Collect patches, general before specific: global, uname, host.
    # A private base shadows the public file entirely, so only private
    # patches apply to it. On a public base, private patches layer on top
    # of the public ones.
    local patches=()
    local layer_records=()

    if [ "$source" = "public" ]; then
        add_patch public global ''
        add_patch public uname "$uname_val"
        add_patch public host "$HOSTNAME"
    fi
    add_patch private global ''
    add_patch private uname "$uname_val"
    add_patch private host "$HOSTNAME"

    # Step 3: Determine rendered location
    local rendered_dir
    if $uses_private; then
        rendered_dir="$PRIVATE_ENV_PATH/rendered"
    else
        rendered_dir="$WLR_ENV_PATH/rendered"
    fi

    if [ -n "$RESOLVE_ONLY" ]; then
        printf 'file\t%s\n' "$path"
        printf 'base\t%s\t%s\n' "$source" "$base_file"
        local record
        for record in ${layer_records[@]+"${layer_records[@]}"}; do
            printf '%s\n' "$record"
        done
        if [ ${#patches[@]} -eq 0 ]; then
            printf 'rendered\t\n'
        else
            printf 'rendered\t%s\n' "$rendered_dir/$path"
        fi
        return 0
    fi

    # If no patches, return the base file directly
    if [ ${#patches[@]} -eq 0 ]; then
        echo "$base_file"
        return 0
    fi

    # Check if re-rendering is needed. The .reference file is a pristine copy
    # of the last render, so edits a program makes to the rendered file can be
    # detected later and folded back into a patch.
    local final="$rendered_dir/$path"
    local reference="$final.reference"
    local needs_patch=
    local current="$base_file"

    mkdir -p "$(dirname "$final")"
    if ! [ -f "$reference" ]; then
        needs_patch=y
    fi
    for patch in "${patches[@]}"; do
        if ! [ -f "$final" ] || ! is_newer "$final" "$patch" || ! is_newer "$final" "$current"; then
            needs_patch=y
            break
        fi
    done

    if [ -n "$needs_patch" ] && [ -f "$final" ] && [ -f "$reference" ] \
            && ! cmp -s "$final" "$reference"; then
        wlr-warn "update: $final was modified since it was last rendered" >&2
        print_diff "$reference" "$final" >&2
        if ! wlr-ask "Discard these modifications and re-render $path?" >&2; then
            return 1
        fi
    fi

    if [ -n "$needs_patch" ]; then
        local tmp previous=""
        current="$base_file"
        for patchfile in "${patches[@]}"; do
            tmp="$(mktemp)"
            if ! patch "$current" "$patchfile" -o "$tmp" >/dev/null 2>&1; then
                wlr-err "Failed to apply patch: $patchfile" >&2
                wlr-err "  to file: $path (base: $base_file)" >&2
                # Show what went wrong
                patch "$current" "$patchfile" --dry-run --verbose 2>&1 | head -20 >&2 || true
                rm -f "$tmp" "$previous"
                return 1
            fi
            # The previous stage is only safe to remove once the next one is written.
            if [ -n "$previous" ]; then
                rm "$previous"
            fi
            previous="$tmp"
            current="$tmp"
        done
        cp -p "$current" "$reference"
        mv "$current" "$final"
    fi

    echo "$final"
}

link_file() {
    local rendered_raw
    if ! rendered_raw="$(render_file "$1")"; then
        wlr-err "Skipping $1"
        return 1
    fi
    local rendered
    rendered="$(realpath "$rendered_raw")"
    if [ -L "$HOME/$1" ]; then
        actual_target="$(realpath "$HOME/$1")"
        if [ "$rendered" != "$actual_target" ]; then
            print_diff "$HOME/$1" "$rendered"
            if wlr-ask "Update symlink $HOME/$1 to point to $rendered (currently $actual_target)?"; then
                ln -sf "$rendered" "$HOME/$1"
            fi
        fi
    elif [ -f "$HOME/$1" ]; then
        if cmp -s "$HOME/$1" "$rendered"; then
            ln -sf "$rendered" "$HOME/$1"
        else
            print_diff "$HOME/$1" "$rendered"
            if wlr-ask "Replace $HOME/$1 with a symlink to $rendered?"; then
                ln -sf "$rendered" "$HOME/$1"
            fi
        fi
    elif [ -e "$HOME/$1" ]; then
        wlr-warn "update: $HOME/$1 exists, but is not a regular file or symlink"
        return 1
    else
        ln -s "$rendered" "$HOME/$1"
    fi
}

# Discover all dotfile paths from both repos
declare -A seen_paths
dotfile_paths=()

# Scan a scope subdirectory of a dotfiles tree, stripping the scope prefix
# from discovered paths so they map to destinations under $HOME.
# Args: <repo-dotfiles-root> <scope-subdir-or-empty>
scan_scope() {
    local root="$1"
    local scope="$2"
    local search_dir
    if [ -z "$scope" ]; then
        search_dir="$root"
    else
        search_dir="$root/$scope"
    fi
    [ -d "$search_dir" ] || return 0
    while IFS= read -r filename; do
        local relative="${filename#"$search_dir/"}"
        # When scanning the global root, skip the scope subtrees so their
        # contents are only reached via the corresponding scope scan.
        if [ -z "$scope" ]; then
            case "$relative" in
                host/*|uname/*) continue ;;
            esac
        fi
        if [ -n "$relative" ] && [ "$relative" != "$filename" ] \
                && [ -z "${seen_paths[$relative]:-}" ]; then
            seen_paths["$relative"]=1
            dotfile_paths+=("$relative")
        fi
    done < <(find -L "$search_dir" -type f 2>/dev/null || true)
}

# Scan order doesn't affect base-file priority (render_file enforces that);
# it only determines the order of dotfile_paths. Use host > uname > global
# so more-specific scopes appear first in the processing queue.
repo_roots=("$WLR_ENV_PATH/dotfiles")
if $HAS_PRIVATE; then
    repo_roots+=("$PRIVATE_ENV_PATH/dotfiles")
fi
for repo_root in "${repo_roots[@]}"; do
    [ -d "$repo_root" ] || continue
    if [ -n "$HOSTNAME" ]; then
        scan_scope "$repo_root" "host/$HOSTNAME"
    fi
    if [ -n "$UNAME_VAL" ]; then
        scan_scope "$repo_root" "uname/$UNAME_VAL"
    fi
    scan_scope "$repo_root" ""
done

if [ -n "$RESOLVE_ONLY" ]; then
    printf 'env\t%s\t%s\n' "$HOSTNAME" "$UNAME_VAL"
    if [ $# -gt 0 ]; then
        dotfile_paths=("$@")
    fi
    for relative in ${dotfile_paths[@]+"${dotfile_paths[@]}"}; do
        render_file "$relative" || wlr-warn "no base file for $relative"
    done
    exit 0
fi

# Process each unique dotfile
failed_files=()
for relative in "${dotfile_paths[@]}"; do
    dir="${relative%/*}"
    if [ "$dir" != "$relative" ]; then
        sync_dir "$dir" || continue
    fi
    if ! link_file "$relative"; then
        failed_files+=("$relative")
    fi
done

# Report summary if there were failures
if [ ${#failed_files[@]} -gt 0 ]; then
    wlr-err ""
    wlr-err "Failed to sync ${#failed_files[@]} file(s):"
    for f in "${failed_files[@]}"; do
        wlr-err "  - $f"
    done
    exit 1
fi
