#!/usr/bin/env bash
set -euo pipefail

# Verify that all patches in the repository (and the private overlay repo,
# ~/.wlrenv-private, if present) apply successfully.
#
# Follows the same layering as wlr-sync-dotfiles:
#   - Base file: scope priority host > uname > global; private shadows public
#     within each scope.
#   - Private base => only private patches apply.
#   - Public base  => public patches apply first, private patches on top.
#
# Limitation: a patch path pins only one scope dimension (host OR uname), so
# prerequisite patches in the other dimension are unknown here and assumed
# absent. wlr-sync-dotfiles applies uname patches before host patches on a
# real machine, so a host patch verified here against the unpatched base may
# still conflict with a uname patch at sync time.

# Color output helpers
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PRIVATE_ENV_PATH="$HOME/.wlrenv-private"
HAS_PRIVATE=false
[[ -d "$PRIVATE_ENV_PATH" ]] && HAS_PRIVATE=true

FAILED=0
TESTED=0
SKIPPED=0

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# Resolve the base file for a path the way wlr-sync-dotfiles does, trying
# each given scope-relative path in order, private before public within each.
# Echoes "<base_file>|<public or private>".
resolve_base() {
    local rel
    for rel in "$@"; do
        if $HAS_PRIVATE && [ -f "$PRIVATE_ENV_PATH/dotfiles/$rel" ]; then
            echo "$PRIVATE_ENV_PATH/dotfiles/$rel|private"
            return 0
        elif [ -f "$WLR_ENV_PATH/dotfiles/$rel" ]; then
            echo "$WLR_ENV_PATH/dotfiles/$rel|public"
            return 0
        fi
    done
    return 1
}

# verify_patch <patch_file> <public or private>
verify_patch() {
    local patch_file="$1"
    local repo="$2"

    local scope_dim scope_val relative_path
    if [[ "$patch_file" =~ patches/host/([^/]+)/(.+)\.patch$ ]]; then
        scope_dim="host"
        scope_val="${BASH_REMATCH[1]}"
        relative_path="${BASH_REMATCH[2]}"
    elif [[ "$patch_file" =~ patches/uname/([^/]+)/(.+)\.patch$ ]]; then
        scope_dim="uname"
        scope_val="${BASH_REMATCH[1]}"
        relative_path="${BASH_REMATCH[2]}"
    else
        echo -e "${RED}✗${NC} Failed to parse patch path: $patch_file"
        FAILED=$((FAILED + 1))
        return
    fi

    local label="[$repo] $scope_dim/$scope_val/$relative_path"

    local base_info
    if ! base_info="$(resolve_base "$scope_dim/$scope_val/$relative_path" "$relative_path")"; then
        echo -e "${RED}✗${NC} $label"
        echo "   Patch file: $patch_file"
        echo "   No base file found in dotfiles/ (public or private)."
        FAILED=$((FAILED + 1))
        return
    fi
    local base_file="${base_info%|*}"
    local source="${base_info#*|}"

    # A private base shadows the public one, so public patches never apply.
    if [ "$source" = "private" ] && [ "$repo" = "public" ]; then
        echo -e "${YELLOW}⊘${NC} $label"
        echo "   Skipped: base file is shadowed by the private overlay, so this patch is inert."
        SKIPPED=$((SKIPPED + 1))
        return
    fi

    # Prerequisite patches that wlr-sync-dotfiles would apply before this one.
    # Only the pinned scope dimension is knowable; see limitation note above.
    local prereqs=()
    if [ "$repo" = "private" ] && [ "$source" = "public" ]; then
        local public_patch="$WLR_ENV_PATH/patches/$scope_dim/$scope_val/$relative_path.patch"
        [ -f "$public_patch" ] && prereqs+=("$public_patch")
    fi

    TESTED=$((TESTED + 1))

    local current="$base_file"
    local step=0
    local stage
    # ${arr[@]+...} guards the expansion for empty arrays under bash 3.2's set -u
    for stage in ${prereqs[@]+"${prereqs[@]}"} "$patch_file"; do
        step=$((step + 1))
        local out="$TMP_DIR/step$step"
        if ! patch "$current" "$stage" -o "$out" >/dev/null 2>&1; then
            echo -e "${RED}✗${NC} $label"
            echo "   Patch file: $patch_file"
            echo "   Base file: $base_file"
            if [ "$stage" != "$patch_file" ]; then
                echo "   Failed while applying prerequisite patch: $stage"
            fi
            echo "   This patch may not apply cleanly to the current version of the file."
            FAILED=$((FAILED + 1))
            return
        fi
        current="$out"
    done

    echo -e "${GREEN}✓${NC} $label"
}

echo "Verifying all patches..."
echo

patch_roots=("$WLR_ENV_PATH/patches|public")
if $HAS_PRIVATE; then
    patch_roots+=("$PRIVATE_ENV_PATH/patches|private")
fi

for root_info in "${patch_roots[@]}"; do
    root="${root_info%|*}"
    repo="${root_info#*|}"
    [ -d "$root" ] || continue
    while IFS= read -r patch_file; do
        verify_patch "$patch_file" "$repo"
    done < <(find "$root" -type f -name "*.patch" | sort)
done

echo
if [ $SKIPPED -gt 0 ]; then
    echo -e "${YELLOW}$SKIPPED patch(es) skipped (shadowed by private overlay).${NC}"
fi
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}All $TESTED patches verified successfully!${NC}"
    exit 0
else
    echo -e "${RED}$FAILED out of $TESTED patches failed to apply.${NC}"
    exit 1
fi
