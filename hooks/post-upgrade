#!/bin/bash
set -euo pipefail

# sync dotfiles
"$WLR_ENV_PATH/bin/meta/wlr-sync-dotfiles"

# check gitconfig setup
if [ ! -f ~/.gitconfig ]; then
    cp "$WLR_ENV_PATH/config/git/local.template" ~/.gitconfig
    wlr-warn "Created ~/.gitconfig from template - edit HOSTNAME, UNAME, and user.signingKey"
elif ! grep -q 'path.*\.wlrenv/config/git/common' ~/.gitconfig; then
    wlr-warn "~/.gitconfig missing include for common gitconfig - see config/git/local.template"
elif ! grep -q 'path.*\.wlrenv/config/git/uname/' ~/.gitconfig; then
    wlr-warn "~/.gitconfig missing include for uname gitconfig - see config/git/local.template"
fi

# set up git config for env
git -C "$WLR_ENV_PATH" config --local gpg.ssh.allowedSignersFile "$WLR_ENV_PATH/.allowed_signers"

# Disable fsmonitor to avoid socket files breaking Nix's path: input
# (fsmonitor creates .git/**/fsmonitor--daemon.ipc which Nix can't handle)
git -C "$WLR_ENV_PATH" config --local core.fsmonitor false
git -C "$WLR_ENV_PATH" submodule foreach --quiet 'git config --local core.fsmonitor false'

if command -v tmux >/dev/null 2>&1; then
    if ! [ -e "$HOME/.tmux/plugins/tpm" ]; then
        mkdir -p ~/.tmux/plugins/
        git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
    fi

    # reload tmux config
    tmux source-file "$HOME/.tmux.conf" && \
    "$HOME/.tmux/plugins/tpm/bin/install_plugins" || echo "Failed to connect to tmux"
fi

# Rebuild Nix environment (includes niri-spacer and other Rust utilities)
"$WLR_ENV_PATH/bin/meta/wlr-nix-rebuild"

# One-time repair for machines upgrading from before the glibc locale fix:
# commits before mold-unwrapped (a1411f5) shadowed Arch's localedef, which
# may have corrupted glibc's store path and wiped the system locale archive.
# The upgraded wlr-check-update exports the old commit; fall back to
# ORIG_HEAD, which the ff-merge just set, for upgrades from older versions.
old_commit="${WLR_UPGRADE_OLD_COMMIT:-$(git -C "$WLR_ENV_PATH" rev-parse -q --verify ORIG_HEAD || true)}"
if [ -n "$old_commit" ] \
    && ! git -C "$WLR_ENV_PATH" cat-file -e "$old_commit:bin/meta/wlr-repair-glibc-locale" 2>/dev/null; then
    "$WLR_ENV_PATH/bin/meta/wlr-repair-glibc-locale" --auto
fi

# Reinstall wlrenv itself so updated source is picked up even without a version bump
"$WLR_ENV_PATH/bin/meta/wlr-install-self" --reinstall

# Install/update declarative uv tools (manifest rendered by wlr-nix-rebuild)
"$WLR_ENV_PATH/bin/meta/wlr-uv-tools-install"
